#include<stdio.h>
#include <string.h>
int main()
{
    char a[100],b[100];
    int sp;
   printf("Enter function to perform (1=strcpy, 2=strcmp, 3=strcat, 4=strlen): ");
    scanf("%d", &sp);

    printf("Enter the string 1:\n");
    scanf("%s",a);

    printf("Enter the string 2 :\n");
    scanf("%s",b);
    switch(sp)
    {
    case 1:
        strcpy(b,a);
        printf("After Copying : %s\n",b);
        break;
    case 2:
         int r=strcmp(a,b);
         if(r>0)
             printf("%s is greater than %s",a,b);
         else if(r<0)
             printf("%s is greater than %s",b,a);
         else
             printf("%s and %s are equal",a,b);
         break;
    case 3:
         strcat(a,b);
         printf("After Concatenation : %s\n",a);
         break;
    case 4:
        printf("Length of %s is %lu and %s is %lu\n", a, strlen(a), b, strlen(b));
        break;
    default:
        printf("INVALID FUNCTION");
    }
    return 0;
}
