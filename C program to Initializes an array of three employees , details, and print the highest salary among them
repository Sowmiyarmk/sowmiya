#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char name[20];
    int emp_id;
    int salary;
} employee;

int main() {
    employee e1[3] = {
        {"Adhin", 10012, 122222},
        {"Paathirin", 10222, 123892},
        {"Abi", 10111, 90000}
    };
    for (int i = 0; i < 3; i++)
    {
      printf("NAME: %s\nEMP_ID: %d\nSALARY: %d\n\n", e1[i].name, e1[i].emp_id, e1[i].salary);
    }
    int max_salary = e1[0].salary;
    for (int i = 1; i < 3; i++)
     {
        if (e1[i].salary > max_salary)
         {
            max_salary = e1[i].salary;
        }
    }
    printf("Highest salary: %d\n", max_salary);
    return 0;
}
