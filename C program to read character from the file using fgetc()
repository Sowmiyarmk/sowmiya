#include <stdio.h>
#include <stdlib.h>

int main()
{
   FILE*fp;
   fp=fopen("charfile.txt","r");
   char ch;
   if(fp==NULL)
   {
       printf("File not found!\n");
       return 1;
   }
   printf("File Contents: \n");
   while((ch=fgetc(fp))!=EOF)
    putchar(ch);
   fclose(fp);
   return 0;
}


