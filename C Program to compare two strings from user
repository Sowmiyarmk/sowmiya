#include<stdio.h>
#include <string.h>
int main()
{
    char a[100],b[100];
    printf("Enter string 1 to compare :\n");
    scanf("%s",a);
    printf("Enter string 2 to compare :\n");
    scanf("%s",b);
    int r= strcmp(a,b);
    if(r>0)
        printf("%s is greater than %s",a,b);
    else if(r<0)
        printf("%s is greater than %s",b,a);
    else
        printf("%s and %s are equal",a,b);
    return 0;
}
